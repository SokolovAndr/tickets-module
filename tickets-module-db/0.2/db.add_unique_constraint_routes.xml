<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="add-unique-constraint-routes" author="andrei.sokolov">
        <preConditions onError="MARK_RAN">
            <and>
                <tableExists tableName="routes"/>
                <not>
                    <indexExists indexName="uq_routes_departure_destination_carrier"/>
                </not>
            </and>
        </preConditions>

        <addUniqueConstraint
                tableName="routes"
                constraintName="uq_routes_departure_destination_carrier"
                columnNames="departure_point, destination_point, carrier_id"/>
    </changeSet>

</databaseChangeLog>