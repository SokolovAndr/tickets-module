<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="add-departure-at-and-destination-at-columns-to-routes-table" author="andrei.sokolov">

        <preConditions onError="MARK_RAN">
            <and>
                <tableExists tableName="routes"/>
                <not>
                    <and>
                        <columnExists tableName="routes" columnName="departure_at"/>
                        <columnExists tableName="routes" columnName="destination_at"/>
                    </and>
                </not>
            </and>

        </preConditions>

        <addColumn tableName="routes">
            <column name="departure_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="routes">
            <column name="destination_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>

