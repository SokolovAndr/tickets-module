<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="drop-departure-datetime-column-from-tickets-table" author="andrei.sokolov">

        <preConditions onError="MARK_RAN">
            <columnExists tableName="tickets" columnName="departure_datetime"/>
        </preConditions>

        <dropUniqueConstraint
                tableName="tickets"
                constraintName="uq_ticket_route_seat_datetime"/>

        <dropColumn tableName="tickets" columnName="departure_datetime"/>

        <addUniqueConstraint
                tableName="tickets"
                constraintName="uq_ticket_route_seat"
                columnNames="route_id, seat_number"/>
    </changeSet>
</databaseChangeLog>

