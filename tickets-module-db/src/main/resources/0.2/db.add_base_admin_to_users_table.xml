<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="add-base-admin-to-users-table" author="andrei.sokolov">
        <preConditions onError="MARK_RAN">
            <and>
                <tableExists tableName="users"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM users WHERE login = 'admin'
                </sqlCheck>
            </and>
        </preConditions>

        <sql dbms="postgresql">
            INSERT INTO users (login, password, full_name, role, created_at, updated_at)
            VALUES ('admin',
                    '$2a$10$FH1BJ5Ui3z776lbIfBmavO0Wihi9XZKrZQ8Zi2EXCjvp4s6fnc3Xm',
                    'Admin Adminov',
                    'ADMIN',
                    CURRENT_TIMESTAMP,
                    CURRENT_TIMESTAMP);        </sql>

    </changeSet>

</databaseChangeLog>