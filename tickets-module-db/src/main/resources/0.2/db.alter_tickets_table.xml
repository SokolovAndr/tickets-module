<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="alter-tickets_table" author="andrei.sokolov">

        <preConditions onError="MARK_RAN">
                <tableExists tableName="tickets"/>
                <columnExists tableName="tickets" columnName="seat_number"/>
        </preConditions>

        <modifyDataType tableName="tickets" columnName="seat_number" newDataType="int"/>

    </changeSet>
</databaseChangeLog>

